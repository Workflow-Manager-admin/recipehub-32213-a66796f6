---
import { useState, useEffect } from 'react';

// Color palette from work item
const COLORS = {
  primary: "#4CAF50",
  secondary: "#FF9800",
  accent: "#E91E63",
  bg: "#fafafa",
  card: "#fff",
  text: "#222",
  border: "#e0e0e0"
};

let initialState = { loading: true, error: null, recipes: [] };

if (Astro.client) {
  // SSR+SPA fallback for Astro
  initialState = Astro.props.initialState || initialState;
}

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>RecipeHub – Browse Recipes</title>
    <style>
      :root {
        --primary: {COLORS.primary};
        --secondary: {COLORS.secondary};
        --accent: {COLORS.accent};
        --bg: {COLORS.bg};
        --card: {COLORS.card};
        --text: {COLORS.text};
        --border: {COLORS.border};
      }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', system-ui, Arial, sans-serif;
        margin: 0;
        min-height: 100vh;
      }
      header {
        background: var(--primary);
        color: #fff;
        padding: 1rem 2rem;
        box-shadow: 0 2px 8px 0 #0001;
        letter-spacing: 1px;
      }
      h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0;
      }
      main {
        max-width: 1200px;
        margin: 2.5rem auto;
        padding: 0 1rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 2px 10px 0 #0001;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.17s;
        cursor: pointer;
        min-height: 320px;
        position: relative;
      }
      .card:hover {
        box-shadow: 0 6px 32px 0 #0002;
        border-color: var(--primary);
      }
      .card-thumb {
        width: 100%;
        aspect-ratio: 4/3;
        object-fit: cover;
        background: #eee;
      }
      .card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 1.25rem;
        gap: 0.5rem;
      }
      .card-title {
        font-size: 1.18rem;
        font-weight: 600;
        color: var(--primary);
        margin-bottom: 0.15em;
      }
      .card-desc {
        font-size: 0.96rem;
        color: #444c;
        flex: 1;
        margin: 0.25em 0 0.5em 0;
      }
      .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--border);
        padding-top: 0.5rem;
        font-size: 0.91rem;
        color: var(--secondary);
        margin-top: auto;
      }
      .placeholder {
        margin: 4rem auto 2rem auto;
        color: var(--accent);
        font-size: 1.3rem;
        text-align: center;
        font-weight: 500;
        opacity: 0.75;
      }
      .loader {
        margin: 3rem auto 2rem auto;
        text-align: center;
        color: var(--secondary);
        font-size: 1.1rem;
      }
      .error {
        margin: 3rem auto 2rem auto;
        text-align: center;
        color: var(--accent);
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>RecipeHub</h1>
      <span style="font-size:1.1rem;opacity:.76;font-weight:400;">Taste, Share, Discover!</span>
    </header>
    <main id="maincontent">
      <h2 style="margin:0 0 0.5em 0; font-size:1.5rem;">Browse Recipes</h2>
      <div id="recipes-root"></div>
    </main>
    <script type="module">
      const apiUrl = "https://vscode-internal-57-qa.qa01.cloud.kavia.ai:3001/recipes";
      const root = document.getElementById("recipes-root");

      function render({ loading, error, recipes }) {
        if (loading) {
          root.innerHTML = '<div class="loader">Loading recipes...</div>';
          return;
        }
        if (error) {
          root.innerHTML = '<div class="error">Failed to load recipes.<br>'+error+'</div>';
          return;
        }
        if (!recipes || recipes.length === 0) {
          root.innerHTML = '<div class="placeholder">No recipes yet. Be the first to add one!</div>';
          return;
        }
        root.innerHTML = `<div class="grid">
          ${recipes.map(r => `
            <div class="card" tabindex="0">
              ${r.image_url ? `<img class="card-thumb" src="${r.image_url}" alt="${r.title} Thumbnail" />` 
                            : `<div class="card-thumb" style="background:#ececec;display:flex;align-items:center;justify-content:center;color:#bbb;">No Image</div>`}
              <div class="card-content">
                <div class="card-title">${r.title}</div>
                <div class="card-desc">${r.description ? r.description.substring(0, 110) + (r.description.length>110 ? '…':'') : '(No description)'}</div>
                <div class="card-footer">
                  ${r.author ? `<span>By ${r.author}</span>` : ''}
                  ${r.created_at ? `<span style="font-size:.89em;opacity:.7;">${new Date(r.created_at).toLocaleDateString()}</span>` : ''}
                </div>
              </div>
            </div>
          `).join('')}
        </div>`;
      }

      render({ loading: true, error: null, recipes: [] });

      fetch(apiUrl)
        .then(resp => {
          if (!resp.ok) throw new Error("API responded " + resp.status);
          return resp.json();
        })
        .then(data => {
          if (Array.isArray(data)) {
            render({ loading: false, error: null, recipes: data });
          } else if (Array.isArray(data.recipes)) {
            render({ loading: false, error: null, recipes: data.recipes });
          } else {
            render({ loading: false, error: "Malformed response", recipes: [] });
          }
        })
        .catch(err => {
          render({ loading: false, error: err.message || "Unknown error", recipes: [] });
        });
    </script>
  </body>
</html>
